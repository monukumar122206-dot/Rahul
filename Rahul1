<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rahul ❤️ Chetna</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Great+Vibes&display=swap" rel="stylesheet">
</head>
<body>

<div id="rain"></div>
<div id="hearts"></div>
<div id="roses"></div>
<div id="lightning"></div>

<section id="loading">
    <h1 class="loading-text">Someone has sent you a Surprise ❤️</h1>
    <p class="loading-sub">Please wait...</p>
    <div class="loader"></div>
</section>

<section id="gift" class="hidden">
    <img src="assets/gift.png" class="gift-box" alt="Gift Box">
    <h2>A Special Gift For You 🎁</h2>
    <button id="openBtn">Open My Heart ❤️</button>
</section>

<section id="main" class="hidden">
    <h1 class="title">Rahul Saini ❤️ Chetna Saini</h1>
    <h2 id="typing"></h2>
    <p class="quote">
        Every heartbeat of mine whispers your name.<br>
        You are my today,<br>
        my tomorrow,<br>
        and forever.
    </p>
    <button id="letterBtn">Read Love Letter 💌</button>
</section>

<section id="letter" class="hidden">
    <div class="letter-box">
        <h2>Dear Chetna ❤️</h2>
        <p id="letterText"></p>
        <button id="nextBtn">Next ❤️</button>
    </div>
</section>

<section id="proposal" class="hidden">
    <h1>Will You Stay With Me Forever?</h1>
    <button id="yesBtn">YES ❤️</button>
</section>

<section id="ending" class="hidden">
    <h1>Forever Yours ❤️</h1>
    <h2>Rahul Saini</h2>
    <div id="fireworks"></div>
</section>

<audio id="bgMusic" loop>
    <source src="assets/bg.mp3" type="audio/mp3">
</audio>

<script src="script.js"></script>
</body>
</html>
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html{
    scroll-behavior: smooth;
}

body{
    font-family: 'Poppins', sans-serif;
    background: #000;
    overflow: hidden;
    color: #fff;
    height: 100vh;
    width: 100%;
}

body::before{
    content: "";
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: url("assets/couple-bg.jpg");
    background-size: cover;
    background-position: center;
    filter: brightness(.28);
    z-index: -5;
}

.hidden {
    display: none !important;
}

#rain, #hearts, #roses, #lightning{
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#rain { z-index: -2; }
#hearts { z-index: 2; overflow: hidden; }
#roses { z-index: 3; }
#lightning { background: #fff; opacity: 0; z-index: 50; }

#loading, #gift, #main, #letter, #proposal, #ending{
    position: absolute;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items:center;
    text-align: center;
    padding: 20px;
}

.loading-text{
    font-size: 38px;
    font-family: 'Great Vibes', cursive;
    color: #ff5fa2;
    text-shadow: 0 0 10px #ff4d94, 0 0 30px #ff0066;
}

.loading-sub{
    margin-top: 15px;
    font-size: 18px;
    opacity: .8;
}

.loader{
    margin-top: 40px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 6px solid rgba(255,255,255,.2);
    border-top: 6px solid hotpink;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.gift-box{
    width: 220px;
    animation: gift 2s infinite alternate;
}

@keyframes gift {
    0% { transform: translateY(0); }
    100% { transform: translateY(-10px); }
}

#gift h2{
    margin-top: 30px;
    font-size: 34px;
    color: #ffd6e7;
}

button{
    margin-top: 30px;
    padding: 15px 40px;
    border: none;
    border-radius: 50px;
    background: #ff2f78;
    color: white;
    font-size: 18px;
    cursor: pointer;
    font-weight: 600;
    box-shadow: 0 0 15px rgba(255,47,120,0.5);
    transition: 0.3s;
}

button:hover{
    transform: scale(1.05);
    background: #ff0055;
}

.rain-drop{
    position: absolute;
    width: 2px;
    height: 90px;
    background: linear-gradient(transparent, rgba(255,255,255,.8));
    animation: rainFall linear infinite;
    opacity: .7;
}

@keyframes rainFall{
    0%{ transform: translateY(-120px); opacity: 0; }
    15%{ opacity: 1; }
    100%{ transform: translateY(110vh); opacity: 0; }
}

.heart{
    position: absolute;
    color: #ff2d75;
    font-size: 25px;
    animation: heartFloat linear infinite;
    text-shadow: 0 0 15px hotpink;
}

@keyframes heartFloat{
    0%{ transform: translateY(100vh) scale(.5); opacity: 0; }
    20%{ opacity: 1; }
    100%{ transform: translateY(-10vh) scale(1.2); opacity: 0; }
}
const loading = document.getElementById("loading");
const gift = document.getElementById("gift");
const main = document.getElementById("main");
const letter = document.getElementById("letter");
const proposal = document.getElementById("proposal");
const ending = document.getElementById("ending");

const openBtn = document.getElementById("openBtn");
const letterBtn = document.getElementById("letterBtn");
const nextBtn = document.getElementById("nextBtn");
const yesBtn = document.getElementById("yesBtn");

const typing = document.getElementById("typing");
const letterText = document.getElementById("letterText");
const music = document.getElementById("bgMusic");

const rainAudio = new Audio("assets/rain.mp3");
rainAudio.loop = true;
rainAudio.volume = 0.25;

setTimeout(() => {
    loading.classList.add("hidden");
    gift.classList.remove("hidden");
}, 4000);

openBtn.addEventListener("click", () => {
    const box = document.querySelector(".gift-box");
    box.style.transition = "1.2s";
    box.style.transform = "scale(1.3) rotateY(720deg)";
    box.style.opacity = "0";

    music.play();
    rainAudio.play();
    heartExplosion();

    setTimeout(() => {
        gift.classList.add("hidden");
        main.classList.remove("hidden");
        typingEffect();
    }, 1000);
});

const text = "I Love You Chetna ❤️";
let i = 0;

function typingEffect() {
    typing.innerHTML = "";
    let timer = setInterval(() => {
        typing.innerHTML += text.charAt(i);
        i++;
        if (i >= text.length) {
            clearInterval(timer);
        }
    }, 120);
}

letterBtn.onclick = () => {
    main.classList.add("hidden");
    letter.classList.remove("hidden");
    typeLetterMessage();
}

const loveMessage = "Dear Chetna ❤️\n\nFrom the moment you came into my life, everything became beautiful. You are my peace, my happiness, and my soulmate. I want to spend all my life making you smile.";
let j = 0;

function typeLetterMessage() {
    letterText.innerHTML = "";
    let timer = setInterval(() => {
        letterText.innerHTML += loveMessage.charAt(j);
        j++;
        if (j >= loveMessage.length) {
            clearInterval(timer);
        }
    }, 50);
}

nextBtn.onclick = () => {
    letter.classList.add("hidden");
    proposal.classList.remove("hidden");
}

yesBtn.onclick = () => {
    proposal.classList.add("hidden");
    ending.classList.remove("hidden");
    heartExplosion();
}

function heartExplosion() {
    for (let k = 0; k < 50; k++) {
        const h = document.createElement("div");
        h.innerHTML = "❤️";
        h.className = "heart";
        h.style.left = "50vw";
        h.style.top = "50vh";
        h.style.position = "fixed";
        h.style.fontSize = (20 + Math.random() * 25) + "px";
        h.style.transform = `translate(${(Math.random() - 0.5) * 700}px, ${(Math.random() - 0.5) * 700}px)`;
        document.body.appendChild(h);

        setTimeout(() => {
            h.remove();
        }, 3000);
    }
}

// Background Rain Drops generator
function createRain() {
    const rainContainer = document.getElementById("rain");
    const drop = document.createElement("div");
    drop.className = "rain-drop";
    drop.style.left = Math.random() * 100 + "vw";
    drop.style.animationDuration = (0.5 + Math.random() * 0.5) + "s";
    rainContainer.appendChild(drop);

    setTimeout(() => {
        drop.remove();
    }, 1000);
}
setInterval(createRain, 50);

// Love Timer
const startDate = new Date("2026-07-26");

function updateLoveTimer() {
    const now = new Date();
    const diff = now - startDate;
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));

    let timer = document.getElementById("loveTimer");
    if (!timer) {
        timer = document.createElement("div");
        timer.id = "loveTimer";
        timer.style.position = "fixed";
        timer.style.top = "15px";
        timer.style.right = "15px";
        timer.style.padding = "12px 20px";
        timer.style.borderRadius = "20px";
        timer.style.background = "rgba(255,255,255,.12)";
        timer.style.backdropFilter = "blur(10px)";
        timer.style.color = "white";
        timer.style.fontSize = "15px";
        document.body.appendChild(timer);
    }
    timer.innerHTML = "❤️ Together Forever<br>" + days + " Days";
}
setInterval(updateLoveTimer, 1000);
